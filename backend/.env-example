SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret-min-32-chars
NODE_ENV=development
# API marketplace. 3001 lo ocupa el backend de nomadas-tour.
PORT=3003
# Origen(es) permitido(s) del FRONTEND marketplace, separado por coma.
# Debe coincidir exactamente con NEXT_PUBLIC_SITE_URL del frontend.
CORS_ORIGIN=http://localhost:3002
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Nomadas Marketplace <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3002
# OPS-EMAIL-001 — temporary Resend recipient gate (default: normal)
# EMAIL_DELIVERY_MODE=normal|restricted|disabled
EMAIL_DELIVERY_MODE=normal
# CSV allowlist when MODE=restricted (empty = fail-safe: skip all)
EMAIL_ALLOWED_RECIPIENTS=
# When true, ticket email is sent by outbox worker
EMAIL_VIA_OUTBOX=false
# Marketplace lock TTL — cliente NO controla ttl_seconds (decidido por endpoint/contexto)
# nomadas-tour usa 600; marketplace usa 900
LOCK_TTL_SECONDS=900
# Trip lifecycle effects via outbox workers (default false until soak)
TRIP_EFFECTS_VIA_OUTBOX=false
# Outbox worker core (se usa cuando se implementen workers del marketplace)
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
# Sentry (off by default)
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Worker health port (Render Free Web Service)
WORKER_HEALTH_PORT=3002
