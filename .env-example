NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# API backend marketplace (puerto propio: 3003)
NEXT_PUBLIC_API_URL=http://localhost:3003/api
# Frontend marketplace. Debe coincidir EXACTAMENTE con CORS_ORIGIN del backend.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Marketplace lock TTL (segundos). Interno siempre es 600 (LOCK_TTL_SECONDS backend).
NEXT_PUBLIC_LOCK_TTL_SECONDS=900
